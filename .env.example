# CylinderX API Configuration
NEXT_PUBLIC_API_BASE_URL=/api/proxy
NEXT_PUBLIC_API_URL=https://xcylinder-api.onrender.com/api/v1
BACKEND_API_URL=https://xcylinder-api.onrender.com/api/v1
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_CUSTOMER_PORTAL=false

# Auth Configuration
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Application Configuration
NEXT_PUBLIC_APP_NAME=CylinderX
NEXT_PUBLIC_APP_DESCRIPTION=Gas Cylinder Leasing and Refill Management Platform
NEXT_PUBLIC_COMPANY_NAME=CylinderX Gas Company

# Feature Flags
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_QR_SCANNER=true
NEXT_PUBLIC_ENABLE_PAYMENT_GATEWAY=true

# External Services
NEXT_PUBLIC_PAYMENT_GATEWAY_URL=
NEXT_PUBLIC_SMS_SERVICE_URL=
NEXT_PUBLIC_EMAIL_SERVICE_URL=